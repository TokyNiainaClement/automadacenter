{% extends 'base.html.twig' %}

{% block title %}
	AutoMadaCenter - Détails véhicule
{% endblock %}

{% block body %}

	<div class="max-w-7xl mx-auto px-14 py-3 grid lg:grid-cols-3 gap-8">
		<div class="lg:col-span-2">
			<a href="javascript:history.back()" class="text-sm text-[#F97316] hover:text-[#ffb066] transition inline-flex items-center gap-2">

				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">

					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>

				</svg>
				Revenir en arrière
			</a>
		</div>
		<div class="lg:col-span-2">
			{% if vehicle.vehicleImages|length >= 1 %}
				<img src="{{ vich_uploader_asset(vehicle.vehicleImages[0], 'vehicleImageFile') }}" class="w-full h-112.5 object-cover rounded-2xl"/>
			{% endif %}

			<div class="grid grid-cols-4 gap-3 mt-4">
				{% if vehicle.vehicleImages|length >= 2 %}
					<img src="{{ vich_uploader_asset(vehicle.vehicleImages[1], 'vehicleImageFile') }}" class="rounded-xl h-24 object-cover w-full"/>
				{% endif %}

				{% if vehicle.vehicleImages|length >= 3 %}
					<img src="{{ vich_uploader_asset(vehicle.vehicleImages[2], 'vehicleImageFile') }}" class="rounded-xl h-24 object-cover w-full"/>
				{% endif %}

				{% if vehicle.vehicleImages|length >= 4 %}
					<img src="{{ vich_uploader_asset(vehicle.vehicleImages[3], 'vehicleImageFile') }}" class="rounded-xl h-24 object-cover w-full"/>
				{% endif %}

				{% if vehicle.vehicleImages|length >= 5 %}
					<img src="{{ vich_uploader_asset(vehicle.vehicleImages[4], 'vehicleImageFile') }}" class="rounded-xl h-24 object-cover w-full"/>
				{% endif %}
			</div>

			<div class="bg-[#222222] border border-[#333] rounded-2xl p-6 mt-6">
				<div class="flex justify-between items-start mb-6">
					<div>
						<h1 class="text-4xl font-black">{{ vehicle.brand }}</h1>
						<p class="text-[#F97316] text-3xl font-black mt-2">
							{{ vehicle.price|number_format(0, ',', ' ') }}
							MGA
						</p>
					</div>

					<span class="bg-[#F97316] px-4 py-2 rounded-full text-sm font-bold">
						Vendeur vérifié
					</span>
				</div>

				<div class="grid md:grid-cols-3 gap-4 text-sm">
					<div class="bg-[#111111] rounded-xl p-4">
						<p class="text-gray-500">Année</p>
						<p class="font-bold text-[#F97316]">{{ vehicle.year }}</p>
					</div>

					<div class="bg-[#111111] rounded-xl p-4">
						<p class="text-gray-500">Kilométrage</p>
						<p class="font-bold text-[#F97316]">{{ vehicle.mileage|number_format(0, ',', ' ') }}
							km</p>
					</div>

					<div class="bg-[#111111] rounded-xl p-4">
						<p class="text-gray-500">Carburant</p>
						<p class="font-bold text-[#F97316]">{{ vehicle.fuelType }}</p>
					</div>

					<div class="bg-[#111111] rounded-xl p-4">
						<p class="text-gray-500">Transmission</p>
						<p class="font-bold text-[#F97316]">{{ vehicle.transmission }}</p>
					</div>

					<div class="bg-[#111111] rounded-xl p-4">
						<p class="text-gray-500">Modèle</p>
						<p class="font-bold text-[#F97316]">{{ vehicle.model }}</p>
					</div>

					<div class="bg-[#111111] rounded-xl p-4">
						<p class="text-gray-500">État</p>
						<p class="font-bold text-[#F97316]">{{ vehicle.vehicleCondition }}</p>
					</div>

					<div class="bg-[#111111] rounded-xl p-4">
						<p class="text-gray-500">Localisation</p>
						<p class="font-bold text-[#F97316]">{{ vehicle.city }}</p>
					</div>

				</div>

				<div class="mt-8">
					<h2 class="text-2xl font-bold mb-4">Description</h2>
					<p class="text-gray-400 leading-relaxed">{{ vehicle.description }}</p>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
