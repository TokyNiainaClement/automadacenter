<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}AutoMadaCenter - Connexion
			{% endblock %}
		</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
	</head>

	{{ importmap('app') }}

	{% block body %}
		<body class="bg-[#1a1a1a] min-h-screen text-white flex items-center justify-center px-4">
			<div class="w-full max-w-md bg-[#222222] border border-[#333] rounded-2xl p-8 shadow-2xl">
				<div class="text-center mb-8">
					<h1 class="text-3xl font-black tracking-tight">
						<span class="text-white">auto</span>
						<span class="text-[#F97316]">mada</span>
						<span class="text-white">center</span>
					</h1>
					<p class="text-gray-500 mt-2 text-sm">Connexion à votre compte</p>
				</div>

				<!-- Erreur d'authentification -->
				{% if last_error %}
					<p class="text-[#ff4d4d] text-sm py-1">
						{{ last_error.messageKey|trans(last_error.messageData, 'security') }}
					</p>
				{% endif %}

				<form class="space-y-5" action="{{ path('security.login') }}" method="post">
					<div>
						<label for="username" class="text-sm text-gray-400 block mb-2">Adresse email</label>
						<input name="_username" id="_username" value="{{ last_username }}" type="email" class="w-full bg-[#111111] border border-[#333] focus:border-[#F97316] rounded-lg px-4 py-3 outline-none" placeholder="email@example.com"/>
					</div>

					<div>
						<label for="password" class="text-sm text-gray-400 block mb-2">Mot de passe</label>
						<input name="_password" id="_password" type="password" class="w-full bg-[#111111] border border-[#333] focus:border-[#F97316] rounded-lg px-4 py-3 outline-none" placeholder="********"/>
					</div>

					<button type="submit" class="w-full bg-[#F97316] hover:bg-[#ea6500] transition-colors py-3 rounded-lg font-bold">
						Se connecter
					</button>
				</form>

				<div class="mt-6 space-y-3">
					<button class="w-full bg-white text-black py-3 rounded-lg font-semibold">
						Continuer avec Google
					</button>

					<button class="w-full bg-blue-600 py-3 rounded-lg font-semibold">
						Continuer avec Facebook
					</button>
				</div>

				<div class="flex justify-between mt-6 text-sm">
					<a href="#" class="text-gray-500 hover:text-[#F97316]">Mot de passe oublié ?</a>
					<a href="{{ path('security.registration') }}" class="text-[#F97316]">Créer un compte</a>
				</div>
			</div>
		</body>
	{% endblock %}
</html>
