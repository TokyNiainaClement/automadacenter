{% extends 'base.html.twig' %}

{% block title %}
	Notifications Administrateur - AutoMadaCenter
{% endblock %}

{% block body %}

	<div
		class="min-h-screen bg-[#1a1a1a] text-white p-6">

		<!-- HEADER -->
		<div class="flex items-center justify-between mb-6">

			<div>
				<h1 class="text-2xl font-bold">
					Notifications
				</h1>

				<p class="text-gray-500 text-sm mt-1">
					Suivi des nouvelles demandes de vendeurs professionnels
				</p>
			</div>

			<div class="bg-[#111111] border border-[#2a2a2a] px-4 py-2 rounded-lg">
				<p class="text-xs text-gray-500">
					Notifications non lues
				</p>

				<h3 class="text-[#F97316] text-xl font-bold">
					3
				</h3>
			</div>

		</div>

		{# Message flashe succès #}
		{% for message in app.flashes('success') %}
			<div class="w-85 bg-[#111111] rounded-xl flex row items-center justify-evenly mb-3">
				<p class="text-[15px] p-4 text-white whitespace-nowrap">
					{{ message }}
				</p>
				<svg class="w-7 h-7 m-4 bg-green-500 rounded-full" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
				</svg>
			</div>
		{% endfor %}

		<!-- LISTE -->
		<div
			class="space-y-4">

			<!-- NOTIFICATION -->
			{% for seller in sellers %}
				<div class="bg-[#111111] border border-[#222] rounded-xl p-5 flex items-start justify-between gap-5 hover:border-[#F97316]/30 transition">

					<div
						class="flex items-start gap-4 flex-1">

						<!-- ICON -->
						<div class="w-12 h-12 rounded-xl bg-[#F97316]/10 flex items-center justify-center shrink-0">

							<svg class="w-6 h-6 text-[#F97316]" fill="none" stroke="currentColor" viewbox="0 0 24 24">

								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>

								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>

							</svg>

						</div>

						<!-- CONTENT -->
						<div class="flex-1">

							<div class="flex items-start justify-between mb-2">

								<div class="flex items-center gap-3">

									<h2 class="text-base font-bold">
										Nouvelle demande vendeur
									</h2>

									<span class="bg-[#F97316]/10 text-[#F97316] text-[11px] px-2 py-1 rounded-md font-semibold">
										En attente
									</span>

								</div>

								<p class="text-[11px] text-gray-500 whitespace-nowrap">
									Il y a 5 min
								</p>

							</div>

							<p class="text-sm text-gray-300 leading-relaxed">

								<span class="font-semibold text-white">
									{{ seller.companyName }}
								</span>

								a soumis une nouvelle demande de vérification vendeur professionnel.

							</p>

							<div class="flex items-center gap-4 mt-3 text-xs text-gray-500">

								<span>
									{{ seller.email }}
								</span>

								<span>
									{{ seller.adresse }}
								</span>

							</div>

						</div>

					</div>

					<!-- ACTIONS -->
					<div class="flex items-center gap-3">

						<a href="{{ path('admin.notification.show', { id:seller.id }) }}" class="bg-[#1a1a1a] hover:bg-[#222] border border-[#333] px-4 py-2 rounded-lg text-sm font-medium transition">
							Voir détails
						</a>

						<a href="{{ path('admin.notification.confirm', { id:seller.id }) }}" class="bg-green-500 hover:bg-green-600 px-4 py-2 rounded-lg text-sm font-semibold transition">
							Valider
						</a>

					</div>

				</div>
			{% endfor %}

		</div>

	</div>

{% endblock %}
