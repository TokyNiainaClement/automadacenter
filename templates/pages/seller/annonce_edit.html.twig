{% extends 'base.html.twig' %}

{% block title %}
	AutoMadaCenter - Modification d'une annonce
{% endblock %}

{% block body %}
	<div class="max-w-5xl mx-auto bg-[#222222] border border-[#333] rounded-2xl p-8 my-5">
		<h1 class="text-xl font-black mb-4">Modifier une annonce</h1>

		{{ form_start(form, { 'attr' : { 'data-turbo' : 'false' } }) }}

		<div class="grid md:grid-cols-2 gap-5">
			<div class="grid md:columns-1">
				{{ form_label(form.title) }}
				{{ form_widget(form.title) }}
				{% for error in form.title.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>
			<div class="grid md:columns-1">
				{{ form_label(form.price) }}
				{{ form_widget(form.price) }}
				{% for error in form.price.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>

			<div class="grid md:columns-1">
				{{ form_label(form.brand) }}
				{{ form_widget(form.brand) }}
				{% for error in form.brand.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>

			<div class="grid md:columns-1">
				{{ form_label(form.model) }}
				{{ form_widget(form.model) }}
				{% for error in form.model.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>

			<div class="grid md:columns-1">
				{{ form_label(form.year) }}
				{{ form_widget(form.year) }}
				{% for error in form.year.vars.errors %}
					<p class="text-red-500 text-sm">{{ error.message }}</p>
				{% endfor %}
			</div>

			<div class="grid md:columns-1">
				{{ form_label(form.mileage) }}
				{{ form_widget(form.mileage) }}
				{% for error in form.mileage.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>

			<div class="grid md:columns-1">
				{{ form_label(form.fuelType) }}
				{{ form_widget(form.fuelType) }}
				{% for error in form.fuelType.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>

			<div class="grid md:columns-1">
				{{ form_label(form.transmission) }}
				{{ form_widget(form.transmission) }}
				{% for error in form.transmission.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>

			<div class="grid md:columns-1">
				{{ form_label(form.color) }}
				{{ form_widget(form.color) }}
				{% for error in form.color.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>

		</div>
		<div class="grid md:columns-2">
			{{ form_label(form.description) }}
			{{ form_widget(form.description) }}
			{% for error in form.description.vars.errors %}
				<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
			{% endfor %}
		</div>
		<div class="grid md:grid-cols-2 gap-5">
			<div class="grid md:columns-1">
				{{ form_label(form.vehicleCondition) }}
				{{ form_widget(form.vehicleCondition) }}
				{% for error in form.vehicleCondition.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>
			<div class="grid md:columns-1">
				{{ form_label(form.city) }}
				{{ form_widget(form.city) }}
				{% for error in form.city.vars.errors %}
					<p class="text-red-500 text-sm mt-1">{{ error.message }}</p>
				{% endfor %}
			</div>
		</div>

		{{ form_row(form.submit) }}
		{{ form_end(form) }}
	</div>
{% endblock %}
