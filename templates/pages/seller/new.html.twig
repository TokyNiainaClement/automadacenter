{% extends 'base.html.twig' %}


{% block title %}
	AutoMadaCenter - Inscription Vendeur
{% endblock %}

{% block body %}
	<div class="max-w-5xl mx-auto bg-[#222222] border border-[#333] rounded-2xl p-8 my-5">
		<h1 class="text-xl font-black">Devenir vendeur professionnel</h1>
		<p class="text-gray-500 mt-4 mb-4">Rejoignez les meilleurs concessionnaires professionnels de Madagascar. Publiez des annonces illimitées avec le badge
			<span class="text-[#F97316]">Vendeur Vérifié</span>
			après audit de votre dossier</p>

		{{ form_start(form) }}

		<div class="grid md:grid-cols-2 gap-5">
			<div class="grid md:columns-1">
				{{ form_label(form.companyName) }}
				{{ form_widget(form.companyName) }}
				{{ form_errors(form.companyName) }}
			</div>
			<div class="grid md:columns-1">
				{{ form_label(form.phoneNumber) }}
				{{ form_widget(form.phoneNumber) }}
				{{ form_errors(form.phoneNumber) }}
			</div>
		</div>

		<div class="grid md:grid-cols-2 gap-5">
			<div class="grid md:columns-1">
				{{ form_label(form.email) }}
				{{ form_widget(form.email) }}
				{{ form_errors(form.email) }}
			</div>
			<div class="grid md:columns-1">
				{{ form_label(form.adresse) }}
				{{ form_widget(form.adresse) }}
				{{ form_errors(form.adresse) }}
			</div>
		</div>

		<div class="grid md:grid-cols-2 gap-5">
			<div class="grid md:columns-1">
				{{ form_label(form.documentFile) }}
				<label class="flex items-center gap-4 w-full border-2 mt-2 border-dashed border-[#333] rounded-xl px-4 py-4 cursor-pointer hover:border-[#F97316] hover:bg-[#f974161d] transition group">
					<span class="shrink-0 w-10 h-10 rounded-full bg-[#3b3a30]/8 flex items-center justify-center text-[#3b3a30] group-hover:bg-[#ffcc5c]/20 transition">
						📄
					</span>
					<span class="flex flex-col gap-0.5">
						<span class="text-sm font-medium text-gray-400">Choisir un fichier</span>
						<span class="text-xs text-gray-400">PDF — max 2 Mo</span>
					</span>
					{{ form_widget(form.documentFile) }}
				</label>
			</div>
			<div class="grid md:columns-1">
				{{ form_label(form.logoFile) }}
				<label class="flex items-center gap-4 w-full border-2 mt-2 border-dashed border-[#333] rounded-xl px-4 py-4 cursor-pointer hover:border-[#F97316] hover:bg-[#f974161d] transition group">
					<span class="shrink-0 w-10 h-10 rounded-full bg-[#3b3a30]/8 flex items-center justify-center text-[#3b3a30] group-hover:bg-[#ffcc5c]/20 transition">
						📷
					</span>
					<span class="flex flex-col gap-0.5">
						<span class="text-sm font-medium text-gray-400">Choisir une image</span>
						<span class="text-xs text-gray-400">PNG, JPG, WEBP — max 2 Mo</span>
					</span>
					{{ form_widget(form.logoFile) }}
				</label>
			</div>
		</div>

		<div>
			{{ form_row(form.submit) }}
		</div>

		{{ form_end(form) }}
	</div>
{% endblock %}
