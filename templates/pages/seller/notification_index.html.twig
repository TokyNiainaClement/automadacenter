{% extends 'base.html.twig' %}

{% block title %}
	Notifications Vendeur - AutoMadaCenter
{% endblock %}

{% block body %}

	<div
		class="min-h-screen bg-[#1a1a1a] text-white p-6">

		<!-- HEADER -->
		<div class="flex items-center justify-between mb-6">

			<div>
				<h1 class="text-2xl font-bold">
					Notifications
				</h1>

				<p class="text-gray-500 text-sm mt-1">
					Vous recevrez ici les messages de l'administrateur.
				</p>
			</div>

			<div class="bg-[#111111] border border-[#2a2a2a] px-4 py-2 rounded-lg">
				<p class="text-xs text-gray-500">
					Notifications non lues
				</p>

				<h3 class="text-[#F97316] text-xl font-bold">
					{{ userNotificationsNonLue }}
				</h3>
			</div>

		</div>

		{# Message flashe succès #}
		{% for message in app.flashes('success') %}
			<div class="w-85 bg-[#111111] rounded-xl flex row items-center justify-evenly mb-3">
				<p class="text-[15px] p-4 text-white whitespace-nowrap">
					{{ message }}
				</p>
				<svg class="w-7 h-7 m-4 bg-green-500 rounded-full" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
				</svg>
			</div>
		{% endfor %}

		<!-- LISTE -->
		<div
			class="space-y-2">

			<!-- NOTIFICATION -->
			{% for userNotification in userNotifications %}
				<div class="bg-[#111111] border border-[#222] rounded-xl p-5 flex items-start justify-between gap-5 hover:border-[#F97316]/30 transition">

					<div
						class="flex items-start gap-4 flex-1">

						<!-- ICON -->
						<div class="w-12 h-12 rounded-xl bg-[#F97316]/10 flex items-center justify-center shrink-0">
							<svg class="text-[#F97316]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="2" y="4" width="20" height="16" rx="2"/>
								<path d="M22 7L13.03 12.7a2 2 0 0 1-2.06 0L2 7"/>
							</svg>
						</div>

						<!-- CONTENT -->
						<div class="flex-1">

							<div class="flex items-start justify-between mb-2">

								<div class="flex items-center gap-3">

									<h2 class="text-base font-bold">
										{{ userNotification.title }}
									</h2>
									{% if userNotification.isRead == false %}
										<span class="bg-[#1a1aff]/10 text-[#1a1aff] text-[11px] px-2 py-1 rounded-md font-semibold">
											Non lue
										</span>
									{% endif %}
								</div>

								<p class="text-[11px] text-gray-500 whitespace-nowrap">
									Il y a 5 min
								</p>

							</div>

							<p class="text-sm text-gray-300 leading-relaxed">
								{{ userNotification.content }}
							</p>
						</div>

					</div>

					<!-- ACTIONS -->
					<div class="flex items-center gap-3">
						{% if userNotification.isRead == false %}
							<a href="{{ path('seller.notification.confirm', { id:userNotification.id }) }}" class="bg-[#1a1a1a] hover:bg-[#222] border border-[#333] px-4 py-2 rounded-lg text-sm font-medium transition">
								Marquer comme lue
							</a>
						{% endif %}
						<a href="{{ path('seller.notification.delete', { id:userNotification.id }) }}" class="border border-red-500 text-red-500 hover:bg-red-500 hover:text-white px-4 py-2 rounded-lg text-sm font-semibold transition">
							Supprimer
						</a>
					</div>

				</div>
			{% endfor %}

		</div>

	</div>

{% endblock %}
